# Server Configuration
PORT=3001

# Supabase Project Credentials (Found in Supabase Project Settings -> API)
# IMPORTANT: Use the Service Role Key here on the server, NEVER expose this to the client!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret passkey known only to you (the website owner) to authorize PPT uploads.
# Keep this secret safe!
OWNER_SECRET_KEY=change-this-to-your-strong-owner-secret-passphrase

